[Unit]
Description=DaemonSight web UI
Documentation=https://github.com/bradbrownjr/daemonsight
After=network-online.target daemonsight-collector.service
Wants=network-online.target

[Service]
Type=simple
User=daemonsight
Group=daemonsight
ExecStart=/opt/daemonsight/venv/bin/daemonsight web
Restart=on-failure
RestartSec=5

# Reads the database and its own config; nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
