[Unit]
Description=DaemonSight collector
Documentation=https://github.com/bradbrownjr/daemonsight
After=network-online.target docker.service fail2ban.service
Wants=network-online.target

[Service]
Type=simple
# Root: reads other users' sockets, the Docker socket and (later) fail2ban and nftables.
ExecStart=/opt/daemonsight/venv/bin/daemonsight collector
UMask=0027
Restart=on-failure
RestartSec=10

NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
